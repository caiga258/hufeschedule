# 统一换行策略：仓库内按文本存储，检出时一律 LF
# 目的：Windows 下的编辑器/IDE 保存为 CRLF 时不产生"整文件改动"的假 diff
* text=auto eol=lf

# Windows 批处理必须 CRLF（cmd 解析依赖行尾）
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件：不做换行转换，也不参与文本 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.jar   binary
*.zip   binary
*.apk   binary
*.aab   binary
*.so    binary
*.dylib binary
*.dll   binary
*.klib  binary
